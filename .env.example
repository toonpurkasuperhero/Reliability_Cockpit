# ── LLM Provider ─────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Model Selection ───────────────────────────────────────────────────────────
# Main agent, adversarial attacker, and structured judge
AGENT_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.6-flash

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_PATH=./data/reliability_cockpit.db

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Change this in production or enable DASHBOARD_REQUIRE_AUTH=true
DASHBOARD_SECRET_KEY=cockpit-secret-key-2026
DASHBOARD_REQUIRE_AUTH=false

# ── Chaos Guardrails ──────────────────────────────────────────────────────────
# Max rounds for the adversarial attacker agent
CHAOS_MAX_ROUNDS=5
# Max USD budget per chaos run (safety limit)
CHAOS_BUDGET_USD=2.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
